#!/usr/bin/env node
// parcel-notes' own check: every test, with Node's built-in runner. The pre-commit hook and the gate run it.
// It ends on one line; a failing run ends with the runner's exit code.
import { spawnSync } from "node:child_process";
import { fileURLToPath } from "node:url";

const top = fileURLToPath(new URL("..", import.meta.url));
const done = spawnSync(process.execPath, ["--test"], { cwd: top, stdio: "inherit" });
if (done.status !== 0) {
  console.log("verify: tests failed");
  process.exit(done.status ?? 1);
}
console.log("verify: tests passed");

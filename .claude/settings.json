{
  "permissions": {
    "deny": [
      "Read(./.env*)",
      "Bash(rm -rf *)",
      "Bash(git *push *--force*)",
      "Bash(git *push -f*)",
      "Bash(git *push * -f*)",
      "Bash(git *push * +*)",
      "Bash(git *push *--mirror*)",
      "Bash(git push --no-verify:*)",
      "Bash(git push --delete:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(git tag:*)",
      "Bash(gh pr merge --admin:*)",
      "Bash(gh pr review --approve:*)",
      "Bash(gh release:*)",
      "Bash(gh api -X DELETE:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh ruleset:*)",
      "Read(~/.ssh/**)",
      "Read(~/.claude/**)",
      "Read(~/.claude-acc*/**)",
      "Read(~/.claude-profiles/**)",
      "Read(~/.claude.json*)",
      "Read(~/.cursor/**)",
      "Read(~/.agent-profiles/verifier/**)"
    ]
  },
  "enabledPlugins": {
    "pstack@parcel-notes": true
  },
  "extraKnownMarketplaces": {
    "parcel-notes": {
      "source": {
        "source": "settings",
        "name": "parcel-notes",
        "plugins": [
          {
            "name": "pstack",
            "source": {
              "source": "git-subdir",
              "url": "https://github.com/cursor/plugins.git",
              "path": "pstack",
              "sha": "f713f14203cd6420cec13cd7c55c32d598dbab68"
            }
          }
        ]
      }
    }
  }
}
